rules_version = '2';

// ⚠ 初版です。Emulatorで検証しながら固めてください。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(teamId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberIds;
    }

    // プロフィール：ログインユーザーなら閲覧可、本人のみ更新可。称号(titleIds)はFunctionsのみ変更可
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.titleIds.size() == 0;
      allow update: if signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['titleIds']);
    }

    // チーム：メンバーのみ閲覧・更新可
    // 招待コードでの参加・memberIdsの追加はCallable経由のみ。
    match /teams/{teamId} {
      // teams自身の読み取り/更新は、自己参照get()を避けてresource.dataを直接見る
      // （isMember()の自己get()は一覧取得(list)クエリの評価時にNull value errorになるため使わない）
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      // 作成者は変更不可。人質（dis称号・team dis称号）を変更できるのは作成者のみ
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'memberIds'])
        && (request.auth.uid == resource.data.createdBy
          || !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['selfDisTitleId', 'teamDisTitleId']));
      allow create: if signedIn() && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid;

      // タスク：閲覧はチームメンバー全員、追加・更新・削除は本人（ownerId）のみ
      match /tasks/{taskId} {
        function validStatusChange() {
          let changed = request.resource.data.diff(resource.data).affectedKeys();
          // 編集は完了判定を変更しない。状態変更と期限変更は分けて扱う。
          return (request.resource.data.status == resource.data.status
              && !changed.hasAny(['completedLate']))
            || (changed.hasOnly(['status', 'completedLate'])
              && ((resource.data.status in ['todo', 'overdue']
                  && request.resource.data.status == 'done'
                  && request.resource.data.completedLate ==
                    (resource.data.status == 'overdue' || resource.data.dueAt <= request.time))
                || (resource.data.status == 'done'
                  && request.resource.data.status == 'todo'
                  && request.resource.data.completedLate == false)));
        }

        allow read: if isMember(teamId);
        allow create: if isMember(teamId) && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.status == 'todo'
          && request.resource.data.dueAt is timestamp
          && request.resource.data.dueAt > request.time
          && request.resource.data.get('completedLate', false) == false
          && !request.resource.data.keys().hasAny(['completedAfterOverdue']);
        allow update: if isMember(teamId) && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'dueAt', 'status', 'completedLate'])
          && validStatusChange();
        allow delete: if isMember(teamId) && resource.data.ownerId == request.auth.uid;
      }
    }

    // 称号マスタ：読み取りのみ（投入はシードスクリプト／管理者）
    match /titles/{titleId} {
      allow read: if signedIn();
    }
  }
}
