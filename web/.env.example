# Firebaseコンソール > プロジェクトの設定 > マイアプリ の値を入れて .env.local にコピー
# ※ AUTH_DOMAIN を空のままにするとGoogleログインが auth/auth-domain-config-required で失敗するので注意
#   （未設定時は lib/firebase.ts が `${PROJECT_ID}.firebaseapp.com` を自動補完する）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-hitojichi
VITE_FIREBASE_APP_ID=

# true ならローカルのFirebase Emulatorに接続する
VITE_USE_EMULATOR=true
